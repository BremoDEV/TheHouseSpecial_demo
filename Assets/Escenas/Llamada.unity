--- !u!114 &2026109871
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2026109870}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ef61c6085503ac4a9cf2c91280bc927, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhoneCall
  questions:
  - text: "\xBFC\xF3mo te has sentido hoy?"
    answers:
    - text: Me encuentro bastante bien.
      tone: 0
    - text: Voy tirando.
      tone: 1
    - text: "Estoy cansada \xFAltimamente."
      tone: 1
    - text: Todo va fatal.
      tone: 2
  - text: "\xBFQu\xE9 tal el trabajo en el restaurante?"
    answers:
    - text: Bien, los clientes son agradables.
      tone: 0
    - text: Mucho trabajo, pero bien.
      tone: 1
    - text: Algunos clientes me sacan de quicio.
      tone: 1
    - text: No soporto a nadie.
      tone: 2
  - text: "\xBFEst\xE1s durmiendo bien?"
    answers:
    - text: "S\xED, duermo del tir\xF3n."
      tone: 0
    - text: "M\xE1s o menos."
      tone: 1
    - text: Me cuesta dormirme.
      tone: 1
    - text: No pego ojo, oigo ruidos en el trastero.
      tone: 2
  - text: "\xBFTe has tomado la medicaci\xF3n?"
    answers:
    - text: "S\xED, todos los d\xEDas."
      tone: 0
    - text: Casi siempre.
      tone: 1
    - text: "Se me olvid\xF3 un d\xEDa."
      tone: 1
    - text: "\xBFPara qu\xE9? Estoy perfectamente."
      tone: 2
  - text: "\xBFHas tenido pensamientos extra\xF1os?"
    answers:
    - text: No, ninguno.
      tone: 0
    - text: Alguno, pero nada importante.
      tone: 1
    - text: Me distraigo con facilidad.
      tone: 1
    - text: Solo pienso en carne.
      tone: 2
  doctorLines:
  - "Respira hondo... \xBFMe sigues?"
  - "\xBFHas dormido bien esta semana?"
  - "\xBFHa pasado algo raro en el trabajo?"
  - Te noto un poco agitada.
  - "\xBFSigues tom\xE1ndote la medicaci\xF3n?"
  - "Cu\xE9ntame c\xF3mo son tus clientes."
  - "\xBFEst\xE1s ah\xED? Te oigo respirar fuerte."
  - 'Recuerda: si algo va mal, me llamas.'
  secondsPerLine: 6
  difficultyPerKill: 0.35
  calmAnswerBonus: -0.2
  nervousAnswerPenalty: 0.3
